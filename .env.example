# Hugging Face token (required for pyannote speaker diarization)
# Copy this file to .env and set your token:
#   cp .env.example .env
HF_TOKEN=hf_your_token_here
PYANNOTE_AUTH_TOKEN=hf_your_token_here

# Service port on host (defaults to 12000, within 12000-12100)
PORT=12000

# Cache directories (in-container paths)
HF_CACHE_DIR=/data/hf
TORCH_HOME=/data/torch
